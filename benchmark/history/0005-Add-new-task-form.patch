Subject: [PATCH 05/10] Add new task form

---
 app/src/components/TaskForm.jsx | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)
 create mode 100644 app/src/components/TaskForm.jsx

diff --git a/app/src/components/TaskForm.jsx b/app/src/components/TaskForm.jsx
new file mode 100644
index 0000000..e4ecf6d
--- /dev/null
+++ b/app/src/components/TaskForm.jsx
@@ -0,0 +1,24 @@
+import React, { useState } from 'react';
+import { url } from '../api.js';
+
+export default function TaskForm({ onAdded }) {
+  const [title, setTitle] = useState('');
+  async function submit(e) {
+    e.preventDefault();
+    const clean = title;
+    if (!clean) return;
+    await fetch(url('/api/tasks'), {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ title: clean }),
+    });
+    setTitle('');
+    onAdded();
+  }
+  return (
+    <form onSubmit={submit} className="toolbar">
+      <input id="new-task" placeholder="New task" value={title} onChange={(e) => setTitle(e.target.value)} />
+      <button>Add</button>
+    </form>
+  );
+}
